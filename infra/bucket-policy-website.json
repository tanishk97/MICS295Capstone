{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::WEBSITE_BUCKET/*",
      "Condition": {
        "StringNotEquals": {
          "s3:RequestObjectTag/trust": "verified"
        }
      }
    }
  ]
}
